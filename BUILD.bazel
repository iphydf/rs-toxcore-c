load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_library", "rust_test")
load("@rules_rust_bindgen//:defs.bzl", "rust_bindgen")

cc_library(
    name = "tox_wrapper",
    hdrs = ["toxcore/src/wrapper.h"],
    deps = ["//c-toxcore"],
)

rust_bindgen(
    name = "tox_bindgen",
    bindgen_flags = [
        "--no-rustfmt-bindings",
        "--default-enum-style=rust",
        "--raw-line=#![allow(non_camel_case_types)]",
        "--raw-line=#![allow(non_upper_case_globals)]",
        "--raw-line=#![allow(non_snake_case)]",
        "--allowlist-function=tox_.*",
        "--allowlist-function=toxav_.*",
        "--allowlist-type=Tox_.*",
        "--allowlist-type=Toxav_.*",
        "--allowlist-var=TOX_.*",
        "--allowlist-var=TOXAV_.*",
    ],
    cc_lib = ":tox_wrapper",
    header = "toxcore/src/wrapper.h",
)

rust_library(
    name = "tox_sys",
    srcs = [":tox_bindgen"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["//c-toxcore"],
)

# Low-level core/ modules — including the callback dispatch layer
# (core/generated/dispatch.rs) — are generated by apigen from the c-toxcore
# headers (toxcore/src/core/generated/). The safe tox/ layer and the small
# core/ glue (iterate_extra.rs, av_groupchat.rs) are hand-written.
rust_library(
    name = "toxcore",
    srcs = glob(["toxcore/src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":tox_sys",
        "//c-toxcore",
        "@crates//:serde",
    ],
)

rust_test(
    name = "toxcore_test",
    srcs = glob(["toxcore/tests/**/*.rs"]),
    args = ["--nocapture"],
    crate_root = "toxcore/tests/integration_test.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-fuse-ld=bfd"],
    deps = [":toxcore"],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":tox_sys",
        ":toxcore",
        ":toxcore_test",
    ],
)
