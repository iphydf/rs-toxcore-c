#!/usr/bin/env python3
"""
A/B benchmark comparison for merkle-tox.

Runs the simulation harness and (optionally) the real-Tox e2e tests
multiple times under two configurations, then reports per-scenario
deltas with statistical significance.

Two measurement layers:

  - **Simulation** (always run): deterministic, fast (~10s per run),
    statistically rigorous. Primary signal for tuning decisions.
  - **E2E real Tox** (--with-e2e): slower (~30-60s per run), noisier
    (real network/scheduling jitter). Advisory: confirms simulation
    wins translate to real-world wins.

Usage:

    # Quick: just simulation (10 runs, ~2 minutes)
    ./ab_compare --runs 10

    # Save current as baseline (sim only)
    ./ab_compare --save baseline.json --runs 10

    # ... make changes ...

    # Compare against baseline (sim only)
    ./ab_compare --baseline baseline.json --runs 10

    # Full: simulation + real-Tox e2e (5 runs each, ~10 minutes)
    ./ab_compare --baseline baseline.json --runs 10 --with-e2e --e2e-runs 5

The script:
  1. Runs simulation N times with different seeds (independent samples)
  2. Optionally runs e2e tests M times (also with different seeds)
  3. Computes mean and stdev per scenario
  4. Welch's t-test for significance
  5. Reports per-layer verdicts: BETTER / WORSE / NO CHANGE
  6. Exit code: 0 = no regression, 2 = simulation regression detected.
     E2E results are advisory only — they never cause non-zero exit.
"""

import argparse
import json
import math
import os
import re
import statistics
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass, field
from pathlib import Path


SIM_TARGET = "//rs-toxcore-c/merkle-tox-bench:merkle-tox-bench"
E2E_TARGET = "//rs-toxcore-c/merkle-tox-tox:integration-test"
E2E_TESTS = ["test_blob_transfer_1mb", "test_blob_transfer_10mb"]


@dataclass
class Series:
    """Multiple samples of the same scenario across runs."""
    scenario_id: int | str
    scenario_name: str
    scores: list[float] = field(default_factory=list)
    blob_ms: list[float] = field(default_factory=list)
    total_bytes_tx: list[float] = field(default_factory=list)
    timeouts: int = 0

    @property
    def mean_score(self) -> float:
        return statistics.mean(self.scores) if self.scores else 0.0

    @property
    def stdev_score(self) -> float:
        return statistics.stdev(self.scores) if len(self.scores) > 1 else 0.0

    @property
    def mean_blob_ms(self) -> float:
        return statistics.mean(self.blob_ms) if self.blob_ms else 0.0

    @property
    def stdev_blob_ms(self) -> float:
        return statistics.stdev(self.blob_ms) if len(self.blob_ms) > 1 else 0.0


# ──────────────────────────────────────────────────────────────────────
# Simulation runs
# ──────────────────────────────────────────────────────────────────────

def run_sim(seed: int, scenarios: str | None = None) -> tuple[dict[int, dict], str]:
    """Run the headless simulation and parse JSON output.

    Returns (parsed_results, captured_stderr) — stderr is returned so the
    caller can show bazel's per-scenario progress lines after the run
    completes (we can't stream them live without making parallel output
    unreadable).
    """
    args = [
        "bazel", "run", "--ui_event_filters=-info,-stdout",
        "--noshow_progress",
        SIM_TARGET, "--",
        "--headless", "--json", "--seed", str(seed),
    ]
    if scenarios:
        args.extend(["--scenarios", scenarios])

    try:
        result = subprocess.run(
            args, capture_output=True, text=True, check=True, timeout=600,
        )
    except subprocess.CalledProcessError as e:
        print(f"sim run failed (seed {seed}): {e.stderr[:500]}", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(f"sim run timed out (seed {seed})", file=sys.stderr)
        sys.exit(1)

    json_start = result.stdout.find("{")
    if json_start == -1:
        print(f"No JSON in sim output:\n{result.stdout[:500]}", file=sys.stderr)
        sys.exit(1)
    payload = json.loads(result.stdout[json_start:])
    parsed = {r["scenario_id"]: r for r in payload["results"]}
    return parsed, result.stderr


_SCENARIO_LINE_RE = re.compile(r"Running scenario|^\s*Score:")


def _extract_scenario_lines(stderr: str) -> list[str]:
    """Pull out the bench harness's per-scenario progress lines from stderr,
    discarding bazel's noise."""
    return [line for line in stderr.splitlines() if _SCENARIO_LINE_RE.search(line)]


def collect_sim_runs(
    n: int, seed_base: int, scenarios: str | None, jobs: int,
) -> dict[int, Series]:
    """Run simulation N times in parallel and group results by scenario.

    Each run is independent (different seed, separate process), so they
    can execute concurrently. Wall-clock time isn't measured by the
    benchmark — it uses virtual time — so CPU contention between parallel
    runs doesn't affect the scores.

    Captured stderr from each run is filtered to the bench harness's
    progress lines and printed when the run completes (not streamed
    live, to keep parallel output readable).
    """
    series: dict[int, Series] = {}
    completed = 0
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        futures = {
            pool.submit(run_sim, seed_base + i, scenarios): seed_base + i
            for i in range(n)
        }
        for fut in as_completed(futures):
            seed = futures[fut]
            completed += 1
            results, stderr = fut.result()
            print(f"  [{completed}/{n}] seed={seed} done", file=sys.stderr)
            for line in _extract_scenario_lines(stderr):
                print(f"      {line.strip()}", file=sys.stderr)
            for sid, r in results.items():
                if sid not in series:
                    series[sid] = Series(scenario_id=sid, scenario_name=r["scenario_name"])
                series[sid].scores.append(r["score"])
                if r.get("blob_completion_time_ms") is not None:
                    series[sid].blob_ms.append(float(r["blob_completion_time_ms"]))
                series[sid].total_bytes_tx.append(float(r["total_bytes_tx"]))
                if r["timed_out"]:
                    series[sid].timeouts += 1
    return series


# ──────────────────────────────────────────────────────────────────────
# E2E real-Tox runs
# ──────────────────────────────────────────────────────────────────────

E2E_LINE_RE = re.compile(
    r"E2E_RESULT size_mb=([\d.]+) elapsed_s=([\d.]+) mbps=([\d.]+) status=(\w+)"
)


def run_e2e_test(test_name: str) -> tuple[float, float, str] | None:
    """Run one e2e test, parse the E2E_RESULT line. Returns (mb, mbps, status) or None."""
    args = [
        "bazel", "test", "--test_output=streamed",
        "--test_arg=--ignored",
        "--test_arg=--nocapture",
        f"--test_filter={test_name}",
        "--cache_test_results=no",
        E2E_TARGET,
    ]
    try:
        result = subprocess.run(
            args, capture_output=True, text=True, timeout=300,
        )
    except subprocess.TimeoutExpired:
        return None

    output = result.stdout + result.stderr
    for line in output.splitlines():
        m = E2E_LINE_RE.search(line)
        if m:
            mb = float(m.group(1))
            mbps = float(m.group(3))
            status = m.group(4)
            return (mb, mbps, status)
    return None


def collect_e2e_runs(n: int) -> dict[str, Series]:
    """Run each e2e test N times."""
    series: dict[str, Series] = {}
    for test in E2E_TESTS:
        for i in range(n):
            print(f"  e2e {test} run {i + 1}/{n}...", file=sys.stderr)
            result = run_e2e_test(test)
            if test not in series:
                series[test] = Series(scenario_id=test, scenario_name=test)
            if result is None:
                series[test].timeouts += 1
                continue
            _mb, mbps, status = result
            if status != "OK":
                series[test].timeouts += 1
                continue
            # For e2e, we use throughput (Mbps) as the score; higher is better.
            series[test].scores.append(mbps)
    return series


# ──────────────────────────────────────────────────────────────────────
# Statistics
# ──────────────────────────────────────────────────────────────────────

def welch_t_test(a: list[float], b: list[float]) -> tuple[float, float]:
    """Welch's t-test. Returns (t-statistic, two-tailed p-value)."""
    if len(a) < 2 or len(b) < 2:
        return 0.0, 1.0
    ma, mb = statistics.mean(a), statistics.mean(b)
    va, vb = statistics.variance(a), statistics.variance(b)
    se = math.sqrt(va / len(a) + vb / len(b))
    if se == 0.0:
        return 0.0, 1.0 if ma == mb else 0.0
    t = (mb - ma) / se
    p = 2.0 * (1.0 - 0.5 * (1.0 + math.erf(abs(t) / math.sqrt(2.0))))
    return t, p


def fmt_delta(delta: float, unit: str = "") -> str:
    sign = "+" if delta >= 0 else ""
    return f"{sign}{delta:.2f}{unit}"


def verdict(
    base: list[float], curr: list[float],
    higher_is_better: bool, p_threshold: float = 0.05,
) -> str:
    if not base or not curr:
        return "?"
    _, p = welch_t_test(base, curr)
    delta = statistics.mean(curr) - statistics.mean(base)
    if p > p_threshold:
        return "≈"
    if (delta > 0) == higher_is_better:
        return "✓ better"
    else:
        return "✗ worse"


# ──────────────────────────────────────────────────────────────────────
# Reporting
# ──────────────────────────────────────────────────────────────────────

def report_single(label: str, series: dict, scoring: str = "score") -> None:
    print(f"\n=== {label} ===")
    if scoring == "mbps":
        print(f"{'Test':<28} {'Throughput Mbps':>20} {'Timeouts':>10}")
        print("-" * 65)
        for sid in sorted(series.keys()):
            s = series[sid]
            tput = f"{s.mean_score:6.2f} ±{s.stdev_score:5.2f}" if s.scores else "       n/a"
            print(f"{s.scenario_name[:28]:<28} {tput:>20} {s.timeouts:>10}")
    else:
        print(f"{'ID':<3} {'Scenario':<28} {'Score':>14} {'Blob ms':>16} {'Timeouts':>10}")
        print("-" * 80)
        for sid in sorted(series.keys()):
            s = series[sid]
            score = f"{s.mean_score:6.2f} ±{s.stdev_score:5.2f}"
            blob = f"{s.mean_blob_ms:7.0f} ±{s.stdev_blob_ms:5.0f}" if s.blob_ms else "        n/a"
            print(f"{sid!s:<3} {s.scenario_name[:28]:<28} {score:>14} {blob:>16} {s.timeouts:>10}")


def report_compare(
    label: str,
    baseline: dict, current: dict,
    higher_is_better: bool = True,
    advisory: bool = False,
) -> tuple[int, int, int]:
    """Returns (better, worse, unchanged) counts."""
    # (header, width, alignment) for each column. Edit here to reformat;
    # all rows below derive from this single source of truth.
    cols = [
        ("ID",       5,  "<"),
        ("Scenario", 24, "<"),
        ("Baseline", 14, ">"),
        ("Current",  14, ">"),
        ("Δ",        9,  ">"),
        ("p",        8,  ">"),
        ("Verdict",  10, ">"),
    ]
    total_width = sum(w for _, w, _ in cols) + len(cols) - 1  # +spaces

    def fmt_row(values: list[str]) -> str:
        return " ".join(
            f"{v:{align}{width}}" for v, (_, width, align) in zip(values, cols)
        )

    advisory_tag = "  [ADVISORY]" if advisory else ""
    print(f"\n=== {label}{advisory_tag} ===")
    print(fmt_row([h for h, _, _ in cols]))
    print("-" * total_width)

    better = worse = unchanged = 0

    for sid in sorted(set(baseline.keys()) | set(current.keys())):
        if sid not in baseline or sid not in current:
            print(f"  {sid}: missing in one side")
            continue
        b, c = baseline[sid], current[sid]

        if not b.scores or not c.scores:
            print(f"  {b.scenario_name}: insufficient samples")
            continue

        delta = c.mean_score - b.mean_score
        _, p = welch_t_test(b.scores, c.scores)
        v = verdict(b.scores, c.scores, higher_is_better)

        if "better" in v:
            better += 1
        elif "worse" in v:
            worse += 1
        else:
            unchanged += 1

        # Truncate scenario name to its column width
        name_width = cols[1][1]
        print(fmt_row([
            str(sid),
            b.scenario_name[:name_width],
            f"{b.mean_score:6.2f}±{b.stdev_score:4.2f}",
            f"{c.mean_score:6.2f}±{c.stdev_score:4.2f}",
            fmt_delta(delta),
            f"{p:.3f}",
            v,
        ]))

    print("-" * total_width)
    print(f"  Summary: {better} better, {worse} worse, {unchanged} unchanged")
    return better, worse, unchanged


def serialize_series(series: dict) -> dict:
    return {
        str(sid): {
            "scenario_name": s.scenario_name,
            "scores": s.scores,
            "blob_ms": s.blob_ms,
            "total_bytes_tx": s.total_bytes_tx,
            "timeouts": s.timeouts,
        }
        for sid, s in series.items()
    }


def deserialize_series(raw: dict, key_type=int) -> dict:
    return {
        key_type(sid): Series(
            scenario_id=key_type(sid),
            scenario_name=v["scenario_name"],
            scores=v["scores"],
            blob_ms=v["blob_ms"],
            total_bytes_tx=v["total_bytes_tx"],
            timeouts=v["timeouts"],
        )
        for sid, v in raw.items()
    }


# ──────────────────────────────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--runs", type=int, default=5, help="Sim runs per configuration")
    p.add_argument("--seed-base", type=int, default=1000, help="Starting RNG seed")
    p.add_argument("--scenarios", type=str, help="Comma-separated scenario IDs")
    p.add_argument("--save", type=str, help="Save current results as baseline JSON")
    p.add_argument("--baseline", type=str, help="Compare against a saved baseline JSON")
    p.add_argument("--with-e2e", action="store_true", help="Also run real-Tox e2e tests")
    p.add_argument("--e2e-runs", type=int, default=3, help="E2E runs per configuration")
    p.add_argument(
        "--jobs", type=int, default=max(1, (os.cpu_count() or 4) // 2),
        help="Parallel sim runs (default: half of CPU count)",
    )
    args = p.parse_args()

    print(
        f"Running {args.runs} sim iterations of working tree (jobs={args.jobs})...",
        file=sys.stderr,
    )
    sim_current = collect_sim_runs(args.runs, args.seed_base, args.scenarios, args.jobs)

    e2e_current: dict[str, Series] = {}
    if args.with_e2e:
        print(f"Running {args.e2e_runs} e2e iterations of working tree...", file=sys.stderr)
        e2e_current = collect_e2e_runs(args.e2e_runs)

    if args.save:
        out = {
            "sim": serialize_series(sim_current),
            "e2e": serialize_series(e2e_current) if e2e_current else {},
        }
        Path(args.save).write_text(json.dumps(out, indent=2))
        print(f"Saved baseline to {args.save}", file=sys.stderr)

    if args.baseline:
        raw = json.loads(Path(args.baseline).read_text())
        # Backwards-compat: old format was a flat dict
        if "sim" not in raw and "e2e" not in raw:
            sim_baseline = deserialize_series(raw, int)
            e2e_baseline: dict[str, Series] = {}
        else:
            sim_baseline = deserialize_series(raw.get("sim", {}), int)
            e2e_baseline = deserialize_series(raw.get("e2e", {}), str)

        better, worse, _ = report_compare(
            "Simulation A/B comparison", sim_baseline, sim_current,
            higher_is_better=True,
        )

        if e2e_baseline and e2e_current:
            report_compare(
                "Real-Tox E2E A/B comparison (Mbps; higher = better)",
                e2e_baseline, e2e_current,
                higher_is_better=True, advisory=True,
            )
            print(
                "\nNOTE: E2E results are ADVISORY — high variance from real "
                "network/scheduling.\n"
                "Trust the simulation verdict for tuning decisions; use E2E "
                "to spot disagreements."
            )

        print()
        if worse > 0:
            print("VERDICT: SIMULATION REGRESSION detected")
            sys.exit(2)
        elif better > 0:
            print("VERDICT: SIMULATION IMPROVEMENT")
        else:
            print("VERDICT: NO SIMULATION CHANGE")
    else:
        report_single("Simulation (working tree)", sim_current, "score")
        if e2e_current:
            report_single("Real-Tox E2E (working tree)", e2e_current, "mbps")


if __name__ == "__main__":
    main()
