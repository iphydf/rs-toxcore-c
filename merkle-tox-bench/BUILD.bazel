load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy", "rust_library", "rust_test")

rust_library(
    name = "merkle-tox-bench-lib",
    srcs = [
        "src/lib.rs",
        "src/harness.rs",
        "src/headless.rs",
        "src/metrics.rs",
        "src/scenario.rs",
        "src/scenario_large.rs",
        "src/tui.rs",
    ],
    crate_name = "merkle_tox_bench",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//rs-toxcore-c/merkle-tox-core",
        "//rs-toxcore-c/tox-proto",
        "@crates//:blake3",
        "@crates//:clap",
        "@crates//:crossbeam",
        "@crates//:crossterm",
        "@crates//:ratatui",
        "@crates//:rand",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "merkle-tox-bench",
    srcs = ["src/main.rs"],
    edition = "2024",
    rustc_flags = ["-Clink-arg=-fuse-ld=bfd"],
    deps = [
        ":merkle-tox-bench-lib",
        "@crates//:clap",
        "@crates//:crossterm",
        "@crates//:ratatui",
    ],
)

TEST_SRCS = glob(["tests/*.rs"])

# Per-test size overrides. Most bench tests fit comfortably in
# the default "medium" (30 s under .bazelrc). A few run wide
# simulations whose fastbuild crypto cost overruns 30 s.
TEST_SIZE_OVERRIDES = {
    "tests/large_group_propagation_test.rs": "enormous",
    "tests/regression_test.rs": "large",
}

[
    rust_test(
        name = src.replace("tests/", "").replace(".rs", "").replace("_", "-"),
        size = TEST_SIZE_OVERRIDES.get(src, "medium"),
        srcs = [src],
        edition = "2024",
        rustc_flags = ["-Clink-arg=-fuse-ld=bfd"],
        deps = [
            ":merkle-tox-bench-lib",
            "//rs-toxcore-c/merkle-tox-core",
        "//rs-toxcore-c/tox-proto",
        ],
    )
    for src in TEST_SRCS
]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":merkle-tox-bench-lib",
        ":merkle-tox-bench",
    ] + [
        ":" + src.replace("tests/", "").replace(".rs", "").replace("_", "-")
        for src in TEST_SRCS
    ],
)
