load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy")

rust_binary(
    name = "groupbot",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_flags = ["-Clink-arg=-fuse-ld=bfd"],
    deps = [
        "//rs-toxcore-c:toxcore",
        "@crates//:clap",
        "@crates//:hex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":groupbot",
    ],
)
