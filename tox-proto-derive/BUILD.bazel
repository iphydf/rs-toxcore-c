load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_proc_macro", "rustfmt_test")

rust_proc_macro(
    name = "tox-proto-derive",
    srcs = glob(["src/*.rs"]),
    edition = "2024",
    rustc_flags = ["-Clink-arg=-fuse-ld=bfd"],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:proc-macro2",
        "@crates//:quote",
        "@crates//:syn",
    ],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":tox-proto-derive"],
)

rustfmt_test(
    name = "rustfmt",
    targets = [":tox-proto-derive"],
)
